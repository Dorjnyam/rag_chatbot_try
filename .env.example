DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:55438/rag
FLASK_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1800
CHUNK_OVERLAP=250
TOP_K=5
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=15
SPARSE_TOP_K=15
RRF_K=60
# Optional local reranker; download command and pinned Qwen snapshot are in README.
RERANKING_ENABLED=false
RERANKER_MODEL_PATH=
QUERY_REWRITING_ENABLED=false
CONTEXT_CHUNKS=6
# Local on-demand OCR uses the application-local instance/tessdata after setup-ocr.ps1.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/path/to/project/instance/tessdata
# LIBREOFFICE_CMD=C:/Program Files/LibreOffice/program/soffice.exe
OCR_LANGUAGES=mon+eng
# Optional: extracted text artifacts are sensitive. Keep disabled except during local debugging.
LOAD_DEBUG_ARTIFACTS=false
LOAD_DEBUG_DIR=load-debug
