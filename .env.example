DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:55438/rag
FLASK_SECRET_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Switch back with AI_PROVIDER=gemini; only the selected provider needs a key.
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1800
CHUNK_OVERLAP=250
TOP_K=5
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=15
SPARSE_TOP_K=15
RRF_K=60
RERANKING_ENABLED=false
# Set to an existing local cross-encoder directory after multilingual evaluation.
RERANKER_MODEL_PATH=
QUERY_REWRITING_ENABLED=false
CONTEXT_CHUNKS=6
# Optional overrides; standard Windows install paths are detected automatically.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/path/to/tessdata
# LIBREOFFICE_CMD=C:/Program Files/LibreOffice/program/soffice.exe
OCR_LANGUAGES=mon+eng
